{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Widget contract v2: data (GET /widgets/<source>)",
  "description": "See SPEC.md. This schema cannot see the catalogue, so it does not check that each value matches its field's type; the dashboard does.",
  "type": "object",
  "required": ["updated_at", "values"],
  "additionalProperties": false,
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "link": {
      "type": "string",
      "pattern": "^(https?://.+|/([^/].*)?)$"
    },
    "values": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "status": {
      "enum": ["ok", "warn", "crit"]
    },
    "entry": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "oneOf": [
            { "type": ["number", "string", "null"] },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/item" }
            }
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "series": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["number", "string"] },
        "status": { "$ref": "#/$defs/status" }
      }
    }
  }
}
